# Copy to config.env (gitignored) and fill in.
#
# Used two ways:
#  - deploy.sh reads it on your workstation.
#  - The stats lines (PVE_NODE onwards) also go to /etc/homelab-site-stats.conf on the Proxmox host.

# --- deploy.sh (workstation) ---
PVE_HOST=pve                   # SSH host alias of the Proxmox host
SSH=ssh                        # e.g. /c/Windows/System32/OpenSSH/ssh.exe in Git Bash on Windows
SCP=scp
CHECK_CT=                      # optional: a container that can reach the site, used for a smoke test
SITE_URL_INTERNAL=             # optional: e.g. http://192.0.2.10/

# --- shared ---
SITE_CT=                       # container ID that runs nginx
SITE_ROOT=/var/www/homelab

# --- stats (Proxmox host, /etc/homelab-site-stats.conf) ---
PVE_NODE=pve
KUMA_CT=                       # optional: Uptime Kuma container ID
KUMA_DIR=/opt/uptime-kuma
OLLAMA_CT=                     # optional: Ollama container ID
MEDIA_PATH=                    # optional: mounted media share, e.g. /mnt/media
